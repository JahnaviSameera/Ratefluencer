# Ratefluencer AI — Required API Keys
# Copy this file to .env and fill in your keys

# Gemini API Key (required for AI agents and content generation)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 (required for scraping real influencer data)
# Get free key at: https://console.cloud.google.com → Enable "YouTube Data API v3"
YOUTUBE_API_KEY=your_youtube_api_key_here

# Pexels API Key (optional — for B-roll images in reel production)
# Get free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Social Media Posting (optional — for direct posting feature)
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_token_here
LINKEDIN_PERSON_URN=urn:li:person:your_id_here

# Server base URL (optional — for image hosting in Instagram posts)
# SERVER_BASE_URL=https://your-domain.com
